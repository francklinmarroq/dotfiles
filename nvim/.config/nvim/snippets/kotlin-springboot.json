      "",
      "    @MockBean",
      "    private lateinit var ${3:resource}Service: ${2:Resource}Service",
      "",
      "    @Test",
      "    @DisplayName(\"GET /api/${4:resources} - Success\")",
      "    fun `test get all`() {",
      "        mockMvc.perform(get(\"/api/${4:resources}\")",
      "                .contentType(MediaType.APPLICATION_JSON))",
      "            .andExpect(status().isOk)",
      "    }",
      "}"
    ],
