  "REST Controller (Kotlin)": {
    "prefix": [
      "krestcontroller",
      "kcontroller"
    ],
    "body": [
      "package ${1:com.example.demo.controller}",
      "",
      "import org.springframework.web.bind.annotation.*",
      "import org.springframework.http.ResponseEntity",
      "",
      "@RestController",
      "@RequestMapping(\"/api/${2:resource}\")",
      "class ${3:Resource}Controller(",
      "    private val ${4:resource}Service: ${3:Resource}Service",
      ") {",
      "",
      "    @GetMapping",
      "    suspend fun getAll(): ResponseEntity<*> {",
      "        return ResponseEntity.ok(${4:resource}Service.findAll())",
      "    }",
      "",
      "    @GetMapping(\"/{id}\")",
      "    suspend fun getById(@PathVariable id: Long): ResponseEntity<*> {",
      "        return ResponseEntity.ok(${4:resource}Service.findById(id))",
      "    }",
      "",
      "    @PostMapping",
      "    suspend fun create(@RequestBody ${5:resource}: ${6:ResourceDTO}): ResponseEntity<*> {",
      "        return ResponseEntity.ok(${4:resource}Service.create(${5:resource}))",
      "    }",
      "",
      "    @PutMapping(\"/{id}\")",
      "    suspend fun update(@PathVariable id: Long, @RequestBody ${5:resource}: ${6:ResourceDTO}): ResponseEntity<*> {",
      "        return ResponseEntity.ok(${4:resource}Service.update(id, ${5:resource}))",
      "    }",
      "",
      "    @DeleteMapping(\"/{id}\")",
      "    suspend fun delete(@PathVariable id: Long): ResponseEntity<Void> {",
      "        ${4:resource}Service.delete(id)",
      "        return ResponseEntity.noContent().build()",
      "    }",
      "}"
    ],
    "description": "Spring Boot REST Controller with CRUD operations in Kotlin using constructor injection"
  },
  "Service Class (Kotlin)": {
    "prefix": [
      "kservice",
      "kspringservice"
    ],
    "body": [
      "package ${1:com.example.demo.service}",
      "",
      "import org.springframework.stereotype.Service",
      "import org.springframework.transaction.annotation.Transactional",
      "",
      "@Service",
      "@Transactional",
      "class ${2:Resource}Service(",
      "    private val ${3:resource}Repository: ${2:Resource}Repository",
      ") {",
      "",
      "    fun findAll(): List<${2:Resource}> {",
      "        return ${3:resource}Repository.findAll()",
      "    }",
      "",
      "    fun findById(id: Long): ${2:Resource} {",
      "        return ${3:resource}Repository.findById(id)",
      "            .orElseThrow { RuntimeException(\"${2:Resource} not found\") }",
      "    }",
      "",
      "    fun create(${4:resource}: ${2:Resource}): ${2:Resource} {",
      "        return ${3:resource}Repository.save(${4:resource})",
      "    }",
      "",
      "    fun update(id: Long, ${4:resource}: ${2:Resource}): ${2:Resource} {",
      "        return ${3:resource}Repository.save(${4:resource}.apply { this.id = id })",
      "    }",
      "",
      "    fun delete(id: Long) {",
      "        ${3:resource}Repository.deleteById(id)",
      "    }",
      "}"
    ],
    "description": "Spring Boot Service class in Kotlin with constructor injection"
  },
