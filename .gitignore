# opencode pulls a full node tree; never commit it
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package-lock.json
*.tui-migration.bak
*.backup

# nvim plugin state is machine-local
nvim/.config/nvim/.git/

# Omarchy regenerates this as a symlink into ~/.local/state/omarchy/current/theme/
# on every `omarchy theme set`. Machine-local state, not config.
nvim/.config/nvim/lua/plugins/theme.lua

# lan-mouse's TLS identity, generated per machine on first run. Never share a
# private key between hosts -- each box gets its own, like an SSH host key.
hosts/*/.config/lan-mouse/*.pem
